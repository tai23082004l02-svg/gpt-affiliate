# Local single-owner application. Keep HOST on loopback.
HOST=127.0.0.1
PORT=3100
APP_URL=http://localhost:3100
DATA_DIR=.data
# Required if APP_URL uses a public HTTPS domain behind a reverse proxy.
# Set a long random password; never commit it. Username: admin.
ADMIN_PASSWORD=
# OAuth credentials from each platform's developer console (not API keys).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Leave false for personal tools. Direct Post requires eligible app + video.publish approval/audit.
TIKTOK_DIRECT_POST_ENABLED=false
# Managed HTTPS hosting only. Do not enable this for a bare public HTTP server.
# ALLOW_PUBLIC_BIND=true
# HOST=0.0.0.0
# Render supplies RENDER_EXTERNAL_URL; APP_URL can be omitted there.
